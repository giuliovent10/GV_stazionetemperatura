// -------------------------
// OGGETTI E VARIABILI
// -------------------------
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);
WebServer server(80);

struct Misura {
  char data[11];  // gg/mm/aaaa
  char ora[9];    // hh:mm:ss
  float temp;
};

Misura storico[MAX_STORICO];
int nStorico = 0;      // quante misure valide
int testaStorico = 0;  // prossima posizione da scrivere

float ultimaTemp = NAN;
bool sensoreOk = false;
bool modoAP = false;
bool oraManuale = false;   // ora impostata dal browser
bool conversioneInCorso = false;
bool primaRichiesta = true;
bool primoLog = true;
unsigned long tRichiesta = 0;
unsigned long ultimaRichiesta = 0;
unsigned long ultimoLog = 0;
unsigned long ledFinoA = 0;

// -------------------------
// OROLOGIO
// -------------------------
bool orologioValido() {
  return time(nullptr) > 1700000000;  // dopo nov 2023 = e' stato impostato
}

// Scrive data e ora locali nei buffer. Ritorna false se l'ora non e' disponibile.
bool prendiOra(char* data, char* ora, long* secondiGiorno = nullptr) {
  if (!orologioValido()) {
    strcpy(data, "N/D");
    strcpy(ora, "N/D");
    if (secondiGiorno) *secondiGiorno = 0;
    return false;
  }
  time_t now = time(nullptr);
  struct tm t;
  localtime_r(&now, &t);
  snprintf(data, 11, "%02d/%02d/%04d", t.tm_mday, t.tm_mon + 1, t.tm_year + 1900);
  snprintf(ora, 9, "%02d:%02d:%02d", t.tm_hour, t.tm_min, t.tm_sec);
  if (secondiGiorno) *secondiGiorno = t.tm_hour * 3600L + t.tm_min * 60L + t.tm_sec;
  return true;
}

// -------------------------
// MISURE
// -------------------------
void salvaSuFile(const Misura& m) {
  bool nuovo = !LittleFS.exists(FILE_LOG);
  File f = LittleFS.open(FILE_LOG, FILE_APPEND);
  if (!f) {
    Serial.println("Errore: impossibile aprire il file di log!");
    return;
  }
  if (nuovo) f.println("Data,Ora,Temperatura_C");
  f.printf("%s,%s,%.2f\n", m.data, m.ora, m.temp);
  f.close();
}

void registraMisura(float t) {
  Misura m;
  prendiOra(m.data, m.ora);
  m.temp = t;

  storico[testaStorico] = m;
  testaStorico = (testaStorico + 1) % MAX_STORICO;
  if (nStorico < MAX_STORICO) nStorico++;

  salvaSuFile(m);
  Serial.printf("%s,%s,%.2f\n", m.data, m.ora, m.temp);
}

// Lettura non bloccante: chiede la conversione, dopo 800 ms legge il risultato.
void gestisciMisura() {
  unsigned long adesso = millis();

  if (!conversioneInCorso) {
    if (primaRichiesta || adesso - ultimaRichiesta >= INTERVALLO_LIVE) {
      primaRichiesta = false;
      ultimaRichiesta = adesso;
      sensors.requestTemperatures();
      tRichiesta = adesso;
      conversioneInCorso = true;
    }
    return;
  }

  if (adesso - tRichiesta < TEMPO_CONVERSIONE) return;

  conversioneInCorso = false;
  float t = sensors.getTempCByIndex(0);

  // -127 = sensore scollegato, 85.0 = valore di accensione (lettura non valida)
  if (t == DEVICE_DISCONNECTED_C || t == 85.0) {
    sensoreOk = false;
    Serial.println("Errore: sensore non trovato o lettura non valida!");
    return;
  }

  sensoreOk = true;
  ultimaTemp = t;
  ledFinoA = adesso + 150;  // lampeggio breve a ogni lettura

  if (primoLog || adesso - ultimoLog >= INTERVALLO_LOG) {
    primoLog = false;
    ultimoLog = adesso;
    registraMisura(t);
  }
}

void gestisciLed() {
  if (!sensoreOk) {  // lampeggio veloce = problema col sensore
    static unsigned long t0 = 0;
    if (millis() - t0 >= 250) {
      t0 = millis();
      digitalWrite(PIN_LED, !digitalRead(PIN_LED));
    }
    return;
  }
  digitalWrite(PIN_LED, millis() < ledFinoA ? HIGH : LOW);
}

// -------------------------
// PAGINE WEB
// -------------------------
void handleRoot() {
  server.send(200, "text/html; charset=utf-8", PAGINA);
}

void handleData() {
  char data[11], ora[9];
  long sec = 0;
  bool sync = prendiOra(data, ora, &sec);

  String ip = modoAP ? WiFi.softAPIP().toString() : WiFi.localIP().toString();

  String j;
  j.reserve(4096);
  j += "{\"ok\":";
  j += sensoreOk ? "true" : "false";
  j += ",\"t\":";
  j += sensoreOk ? String(ultimaTemp, 2) : String("null");
  j += ",\"sync\":";
  j += sync ? "true" : "false";
  j += ",\"src\":\"";
  j += (oraManuale && modoAP) ? "manuale" : "ntp";
  j += "\",\"data\":\"" + String(data) + "\"";
  j += ",\"ora\":\"" + String(ora) + "\"";
  j += ",\"sec\":" + String(sec);
  j += ",\"ap\":";
  j += modoAP ? "true" : "false";
  j += ",\"ip\":\"" + ip + "\"";
  j += ",\"log\":[";
  for (int i = 0; i < nStorico; i++) {  // dalla piu' vecchia alla piu' recente
    int idx = (testaStorico - nStorico + i + MAX_STORICO) % MAX_STORICO;
    if (i) j += ",";
    j += "[\"" + String(storico[idx].data) + "\",\"" + String(storico[idx].ora) + "\"," +
         String(storico[idx].temp, 2) + "]";
  }
  j += "]}";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}

// Imposta l'ora usando quella del browser (solo se manca l'ora NTP)
void handleSetTime() {
  if (!server.hasArg("t")) {
    server.send(400, "text/plain", "parametro t mancante");
    return;
  }
  time_t t = (time_t)strtoul(server.arg("t").c_str(), nullptr, 10);
  if (t < 1700000000) {
    server.send(400, "text/plain", "ora non valida");
    return;
  }
  if (orologioValido()) {
    server.send(200, "text/plain", "ora gia' impostata");
    return;
  }
  struct timeval tv = {t, 0};
  settimeofday(&tv, nullptr);
  oraManuale = true;
  Serial.println("Ora impostata dal browser.");
  server.send(200, "text/plain", "ok");
}

void handleCsv() {
  if (!LittleFS.exists(FILE_LOG)) {
    server.send(404, "text/plain", "Nessuna misura registrata.");
    return;
  }
  File f = LittleFS.open(FILE_LOG, FILE_READ);
  server.sendHeader("Content-Disposition", "attachment; filename=temperature.csv");
  server.streamFile(f, "text/csv");
  f.close();
}

void handleCancella() {
  LittleFS.remove(FILE_LOG);
  nStorico = 0;
  testaStorico = 0;
  server.send(200, "text/plain", "ok");
}

// -------------------------
// RETE
// -------------------------
void avviaRete() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("Connessione Wi-Fi");
  int tentativi = 0;
  while (WiFi.status() != WL_CONNECTED && tentativi < 30) {
    delay(500);
    Serial.print(".");
    tentativi++;
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    modoAP = false;
    Serial.print("Wi-Fi connesso! Apri nel browser: http://");
    Serial.println(WiFi.localIP());
    configTzTime(fusoOrario, ntpServer);
  } else {
    Serial.println("Wi-Fi non disponibile: avvio Access Point (l'ora verra' presa dal browser).");
    WiFi.mode(WIFI_AP);
    WiFi.softAP(ap_ssid, ap_password);
    modoAP = true;
    Serial.print("Collegati alla rete ");
    Serial.print(ap_ssid);
    Serial.print(" e apri http://");
    Serial.println(WiFi.softAPIP());
  }
}

// -------------------------
// SETUP E LOOP
// -------------------------
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println();
  Serial.println("--- STAZIONE TERMICA COMPLETA ---");

  pinMode(PIN_LED, OUTPUT);
  digitalWrite(PIN_LED, LOW);

  // fuso orario italiano (serve anche se l'ora arriva dal browser)
  setenv("TZ", fusoOrario, 1);
  tzset();

  sensors.begin();
  sensors.setResolution(12);
  sensors.setWaitForConversion(false);  // lettura non bloccante
  Serial.print("Sensori trovati: ");
  Serial.println(sensors.getDeviceCount());

  if (!LittleFS.begin(true)) {  // true = formatta se e' la prima volta
    Serial.println("Errore: LittleFS non avviato, il log su file non funzionera'.");
  }

  avviaRete();

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/settime", handleSetTime);
  server.on("/csv", handleCsv);
  server.on("/cancella", handleCancella);
  server.begin();
  Serial.println("Web server avviato.");

  Serial.println("Data,Ora,Temperatura_C");
}

void loop() {
  server.handleClient();

  // Riconnessione automatica se si e' in modalita' client e il Wi-Fi cade
  if (!modoAP && WiFi.status() != WL_CONNECTED) {
    static unsigned long ultimoTentativo = 0;
    if (millis() - ultimoTentativo >= 30000) {
      ultimoTentativo = millis();
      Serial.println("Wi-Fi perso, riconnessione...");
      WiFi.disconnect();
      WiFi.begin(ssid, password);
    }
  }

  gestisciMisura();
  gestisciLed();
}

