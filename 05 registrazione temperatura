/*
  05 - Registrazione temperatura in formato CSV su Serial Monitor
  Correzioni rispetto alla versione originale:
   - pin del sensore uniformato a GPIO 16, come nel montaggio (prima era 15)
   - se il Wi-Fi/NTP non e' pronto in setup(), il programma ora riprova
     nel loop() invece di restare bloccato senza registrare
   - la prima misura viene fatta subito, senza aspettare 60 secondi
*/

#include <WiFi.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include "time.h"

// -------------------------
// CONFIGURAZIONE WIFI
// -------------------------
const char* ssid = "NOME_RETE_WIFI";
const char* password = "PASSWORD_WIFI";

// -------------------------
// CONFIGURAZIONE NTP
// -------------------------
const char* ntpServer = "pool.ntp.org";
const char* fusoOrario = "CET-1CEST,M3.5.0/2,M10.5.0/3";

// -------------------------
// CONFIGURAZIONE SENSORE
// -------------------------
#define ONE_WIRE_BUS 16

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

// -------------------------
// INTERVALLO DI MISURAZIONE
// -------------------------
const unsigned long intervallo = 60000;  // 60 secondi
unsigned long ultimaMisura = 0;
bool primaMisura = true;
bool ntpAvviato = false;

bool connettiWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("Connessione Wi-Fi");
  int tentativi = 0;
  while (WiFi.status() != WL_CONNECTED && tentativi < 30) {
    delay(500);
    Serial.print(".");
    tentativi++;
  }
  Serial.println();

  return WiFi.status() == WL_CONNECTED;
}

void avviaNTP() {
  configTzTime(fusoOrario, ntpServer);
  ntpAvviato = true;

  struct tm timeinfo;
  if (getLocalTime(&timeinfo, 15000)) {
    Serial.println("Orologio sincronizzato!");
  } else {
    Serial.println("Attenzione: ora non ancora disponibile, riprovo piu' tardi.");
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println();
  Serial.println("--- STAZIONE TERMICA ---");

  sensors.begin();
  sensors.setResolution(12);

  if (connettiWiFi()) {
    Serial.println("Wi-Fi connesso!");
    avviaNTP();
  } else {
    Serial.println("Errore Wi-Fi! Riprovero' nel loop.");
  }

  // Intestazione CSV
  Serial.println("Data,Ora,Temperatura_C");
}

void loop() {
  // Riconnessione automatica se serve
  if (WiFi.status() != WL_CONNECTED) {
    static unsigned long ultimoTentativo = 0;
    if (millis() - ultimoTentativo >= 30000 || ultimoTentativo == 0) {
      ultimoTentativo = millis();
      Serial.println("Wi-Fi assente, riconnessione...");
      if (connettiWiFi()) {
        Serial.println("Wi-Fi riconnesso!");
        if (!ntpAvviato) avviaNTP();
      }
    }
    return;
  }

  if (primaMisura || millis() - ultimaMisura >= intervallo) {
    primaMisura = false;
    ultimaMisura = millis();

    struct tm timeinfo;

    if (!getLocalTime(&timeinfo, 2000)) {
      Serial.println("Errore: orario non disponibile!");
      return;
    }

    sensors.requestTemperatures();
    float temperatura = sensors.getTempCByIndex(0);

    if (temperatura == DEVICE_DISCONNECTED_C) {
      Serial.println("Errore: sensore non trovato!");
      return;
    }

    // Registrazione dati CSV
    Serial.printf("%02d/%02d/%04d,%02d:%02d:%02d,%.2f\n",
                  timeinfo.tm_mday,
                  timeinfo.tm_mon + 1,
                  timeinfo.tm_year + 1900,
                  timeinfo.tm_hour,
                  timeinfo.tm_min,
                  timeinfo.tm_sec,
                  temperatura);
  }
